        },
        {
          "title": "Name constellation",
          "fields": [
            {
              "key": "name_style.color",
              "type": "color",
              "label": "Constellation colour",
              "default": "#FFD18C"
            },
            {
              "key": "name_style.line_width",
              "type": "number",
              "label": "Line thickness",
